{
  "manifest_version": 2,
  "name": "Acute Page Notes",
  "version": "0.1.0",
  "description": "Keep private notes attached to webpages on this device.",
  "browser_specific_settings": {
    "gecko": {
      "id": "page-notes@acuteweb.core"
    }
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "browser_action": {
    "default_title": "Page Notes",
    "default_popup": "popup.html"
  }
}
